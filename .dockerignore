# Only engine/ and client/ are needed to build the backend binary.
.git
.github
bin
recall_id.txt
*.db
*.log
*.pid

# Docs, tooling, and unrelated sub-projects
docs
homebrew
check-reserved
mcp
tools
examples
container
web

# Node / editor cruft
**/node_modules
**/dist
.DS_Store
.idea
.vscode

# Credentials. The final image is built from a separate stage and contains only
# the compiled binary, so nothing here would be baked in — but the whole build
# context is uploaded to the remote builder, and none of these belong there.
.env
.env.*
*.pem
*.key
*.p12
credentials*.json
